# Watchpost systemd — Telegram + Canary webhook receiver
[Unit]
Description=Watchpost webhook receiver + Telegram alerts
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/beelzebub
EnvironmentFile=-/home/ubuntu/beelzebub/secrets/telegram.env
ExecStart=/usr/bin/python3 /home/ubuntu/beelzebub/intel/receiver.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

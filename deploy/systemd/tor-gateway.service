# Watchpost systemd — Tor-exit policy gateway on :80
[Unit]
Description=Watchpost Tor-exit policy gateway (port 80)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/ubuntu/beelzebub
Environment=WATCHPOST_DATA=/home/ubuntu/beelzebub/data
ExecStart=/usr/bin/python3 /home/ubuntu/beelzebub/intel/tor_gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
